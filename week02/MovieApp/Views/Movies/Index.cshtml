@model IEnumerable<MovieApp.Models.Movie>

@{
    ViewData["Title"] = "My Movies";
}

<h1>My Movies</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<form asp-action="Index" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-5">
        <label for="searchString" class="form-label">Search title</label>
        <input type="text" id="searchString" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" />
    </div>
    <div class="col-md-4">
        <label for="minYear" class="form-label">Year or newer</label>
        <input type="number" id="minYear" name="minYear" value="@ViewData["CurrentMinYear"]" min="1900" max="2100" class="form-control" />
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-secondary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No movies match your current search.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Release Date</th>
                <th>Genre</th>
                <th>Price</th>
                <th>Rating</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Title)</td>
                    <td>@item.ReleaseDate.ToString("yyyy")</td>
                    <td>@Html.DisplayFor(modelItem => item.Genre)</td>
                    <td>@Html.DisplayFor(modelItem => item.Price)</td>
                    <td>@Html.DisplayFor(modelItem => item.Rating)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
